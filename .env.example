# Plantilla de variables de entorno.
# Copiar a `.env` (que está en .gitignore y nunca se commitea) y completar:
#     cp .env.example .env

# ── BASE DE DATOS (PostgreSQL) ────────────────────────────────────────────────
DB_NAME=tegdb
DB_USER=teg
DB_PASSWORD=cambiar_por_password_seguro

# ── APLICACIÓN ────────────────────────────────────────────────────────────────
# Orígenes permitidos por CORS (coma-separado, sin espacios).
# Puerto 80 = frontend en Docker · 4200 = ng serve en desarrollo.
FRONTEND_URL=http://localhost,http://localhost:4200

# ── SEGURIDAD ─────────────────────────────────────────────────────────────────
# Se usa como bytes crudos de la clave HMAC: 64 chars => HS512.
# Mínimo 48 chars, si no jjwt falla al firmar.
# Generar uno nuevo con:  openssl rand -hex 32
JWT_SECRET=cambiar_por_string_aleatorio_de_al_menos_48_caracteres
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# true solo detrás de HTTPS.
COOKIE_SECURE=false

# ── LOGGING ───────────────────────────────────────────────────────────────────
LOG_LEVEL=WARN
