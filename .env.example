# ── BASE DE DATOS ──────────────────────────────────────────────────────────────
# Credenciales de PostgreSQL. Usar valores seguros en producción.
DB_USER=postgres
DB_PASSWORD=cambiar_por_password_seguro

# ── APLICACIÓN ─────────────────────────────────────────────────────────────────
# URL pública del frontend (usada en CORS del backend)
FRONTEND_URL=http://localhost

# ── VARIABLES IDENTIFICADAS EN EL PROYECTO ────────────────────────────────────
JWT_SECRET=cambiar_por_string_aleatorio_minimo_32_chars_base64
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# true en producción con HTTPS, false en desarrollo
COOKIE_SECURE=false
