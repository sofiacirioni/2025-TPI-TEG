# ── BASE DE DATOS ──────────────────────────────────────────────────────────────
# Credenciales de PostgreSQL. Usar valores seguros en producción.
DB_USER=postgres
DB_PASSWORD=cambiar_por_password_seguro

# ── APLICACIÓN ─────────────────────────────────────────────────────────────────
# URL pública del frontend (usada en CORS del backend)
FRONTEND_URL=http://localhost

# ── VARIABLES IDENTIFICADAS EN EL PROYECTO ────────────────────────────────────
# El proyecto no usa JWT ni otros secrets adicionales.
# Si en el futuro se agrega autenticación con JWT, agregar aquí:
# JWT_SECRET=cambiar_por_secreto_seguro_minimo_32_caracteres
# JWT_EXPIRATION_MS=86400000
