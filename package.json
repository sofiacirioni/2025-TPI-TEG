{
  "name": "teg-monorepo",
  "version": "1.0.0",
  "description": "Monorepo for TEG Project (Angular + Spring Boot)",
  "scripts": {
    "start": "npx concurrently --kill-others -n \"BACKEND,FRONTEND\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "cd Backend && .\\mvnw.cmd spring-boot:run",
    "start:frontend": "cd Frontend && npm start",
    "test:tablero": "npx playwright test e2e/tablero-dev.spec.ts",
    "test:tablero:setup": "npx playwright test e2e/tablero-dev.setup.ts --project=setup",
    "test:tablero:only": "npx playwright test e2e/tablero-dev.spec.ts --project=chromium",
    "test:tablero:screenshot": "npx playwright test e2e/tablero-dev.spec.ts --project=chromium --grep screenshot"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "concurrently": "^8.2.2"
  }
}
