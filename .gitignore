# ===========================================
# .gitignore Unificado - Monorepo TEG
# Frontend (Angular) + Backend (Java/Spring Boot)
# ===========================================

# ========== ANGULAR / NODE ==========
# Dependencias
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Build outputs
dist/
tmp/
out-tsc/
.angular/
bazel-out/

# Angular cache
.angular/cache/
.sass-cache/

# ========== JAVA / MAVEN ==========
# Maven
target/
!.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.properties
!**/src/main/**/target/
!**/src/test/**/target/
#.mvn/
!mvnw
!mvnw.cmd

# Compiled class files
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*

# ========== IDEs y EDITORES ==========
# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/

# Eclipse
.classpath
.project
.settings/
bin/
*.tmp
*.bak
*.swp
*~.nib
local.properties
.loadpath
.recommenders

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# Visual Studio
.vs/

# ========== BASE DE DATOS ==========
# H2 Database files
*.mv.db
*.trace.db
*.db
data/

# ========== SISTEMA OPERATIVO ==========
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.directory
.Trash-*

# ========== LOGS Y TEMPORALES ==========
*.log
*.log.*
logs/
*.pid
*.seed
*.pid.lock

# ========== TESTING ==========
coverage/
.nyc_output/
test-results/
junit.xml

# ========== MISCELÁNEOS ==========
*.swp
*.swo
*~
.cache/
.parcel-cache/
connect.lock
typings/
libpeerconnection.log
testem.log

